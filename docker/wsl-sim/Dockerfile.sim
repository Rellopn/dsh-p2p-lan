# Self-contained image for the WSL/port-forward simulation: the plugin's own
# compiled modules + its runtime deps (ws/zod), no host mounts needed.
FROM node:22-bookworm
RUN mkdir -p /opt/sim && cd /opt/sim \
    && npm init -y >/dev/null 2>&1 \
    && npm pkg set type=module \
    && npm install ws zod --no-audit --no-fund --silent
COPY lib/types /opt/sim/lib/types
COPY docker/wsl-sim /opt/sim/docker/wsl-sim
WORKDIR /opt/sim