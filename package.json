{
  "name": "@rellopn/dsh-p2p-lan-workspace",
  "version": "0.1.0-rc.5",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.host.json && tsdown --env.DSH_BUILD_FACE host && tsc -b tsconfig.client.json && tsdown --env.DSH_BUILD_FACE client",
    "test": "pnpm --filter @rellopn/dsh-p2p-lan test"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-typert-generator": "^0.1.0-rc.5",
    "@types/node": "^22.20.0",
    "lightningcss": "^1.32.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  }
}
